# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Derived artifacts of the abandoned GhostGuard sim — regenerate with:
#   python archive/ghostguard/code/run_all.py
archive/ghostguard/results/train_labels.npz
archive/ghostguard/results/_smoke.log

# LaTeX build products, wherever a .tex is compiled
proposal/**/*.aux
proposal/**/*.log
proposal/**/*.out
proposal/**/*.toc
proposal/**/*.fls
proposal/**/*.fdb_latexmk
proposal/**/*.synctex.gz

# OS
Thumbs.db
.DS_Store

# Datasets and downloaded papers — tens of GB, never commit these
raw/dataset/
raw/**/*.pdf
raw/**/*.zip

# Exported models (regenerate: python code/edge/export_backbone.py, occ_model.py)
onnx/

# graphify knowledge-graph output (regenerate: /graphify .)
graphify-out/

# Jetson benchmark logs are worth keeping, engines are not
**/*.engine
**/*.plan

# Jetson artifacts: large binaries kept locally, not in git.
# Recreate with code/edge/jetson_patches/ + notes/JETSON_SETUP.md if lost.
jetson_artifacts/models/
jetson_artifacts/wheels/
jetson_artifacts/detections/
jetson_artifacts/out/

# PDF build intermediates (regenerate: python code/make_proposal_pdf.py)
build/

# Documents carrying the DSS cover page: student ID, GPA, and the mentor's
# signature. This repo is public (GitHub Pages requires it), so these never leave
# the machine. The folder's README is the one exception, so it explains itself.
proposal/private/*
!proposal/private/README.md

# Word's lock files for open documents
~$*
